# Where processing runs: server (everything on this machine) or hybrid (a GPU PC does it). ./setup.sh asks.
COMPUTE_MODE=

# Sign-in uses a username and password. ./setup.sh creates the account, or later:
#   docker compose exec api python -m app.auth set-password
# Optional: a fixed bearer token for scripts (curl import, old Shortcuts). Leave empty to use sign-in only.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=

# Host directory for downloaded media (bind-mounted to /media). Defaults to ./data/media.
MEDIA_HOST_DIR=/var/lib/saved/media

TZ=Europe/Istanbul
# Extract/enrich/index batches for exported items only run in this window ("always" = no window).
BATCH_WINDOW=01:00-07:00
# Random delay between export fetches, seconds. Share-sheet items skip it.
FETCH_DELAY_MIN=20
FETCH_DELAY_MAX=40
# Downloads at once (each slot pauses FETCH_DELAY_MIN..MAX after its fetch). More is faster but Instagram rate-limits sooner.
FETCH_SLOTS=1
# Fetching pauses when free space on the media disk drops below this.
MIN_FREE_GB=5

THREADS=4
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
KEYFRAMES=8
# Vision tagging runs on a GPU PC on your LAN (tools/pc-llm). While it is unreachable, items wait.
LLM_REMOTE_URL=http://<gpu-pc-ip>:8099
# Must match tools/pc-llm/key.txt on the PC.
LLM_REMOTE_KEY=
# 1 = share-sheet items use a slow CPU llama-server on this server while the GPU PC is off (~3.5 min each, 4B model).
LLM_LOCAL_FALLBACK=0
# That CPU fallback's model file, vision projector and context size.
LLM_MODEL_PATH=/data/models/Qwen3.5-4B-Q4_K_M.gguf
LLM_MMPROJ_PATH=/data/models/qwen35-mmproj-F16.gguf
LLM_CTX=4096
# Changing it rebuilds the text index and re-indexes every item.
TEXT_EMBED_MODEL=google/embeddinggemma-2
VISUAL_EMBED_MODEL=google/siglip2-base-patch16-224
# 0 = FTS-only search in the api (saves ~1.5-2 GB RAM, no ML libs needed at query time).
SEARCH_MODELS=1
# Query models (bf16) unload after this many idle seconds; the next search reloads them (~10-20 s).
SEARCH_IDLE_UNLOAD=900
# Total RAM shown in the status page; set it when Docker runs in an LXC whose limit is not visible inside (bytes).
# SYSTEM_MEM_BYTES=4294967296
# Origins allowed to call the API from a browser context (the desktop app).
# CORS_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost
